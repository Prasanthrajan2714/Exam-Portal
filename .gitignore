# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated prisma client (recreated by `npm run db:generate`)
/lib/generated

# uploaded question papers and answer keys
/uploads

# playwright artifacts
/test-results
/playwright-report
/blob-report
/playwright/.cache

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
