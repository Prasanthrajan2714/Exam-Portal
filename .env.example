# Copy to .env and fill in.

# --- Database -------------------------------------------------------------
# Local Postgres installed via winget (PostgreSQL 17), database `firstbench_exam`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/firstbench_exam?schema=public"

# --- Auth -----------------------------------------------------------------
# Signing key for session JWTs. MUST be replaced for any real deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# --- Uploads --------------------------------------------------------------
# Directory for uploaded question papers and answer keys.
# Swap for S3/blob storage when moving off a single server.
UPLOAD_DIR="./uploads"

# --- Email ----------------------------------------------------------------
# Used to send students their username and password.
# If SMTP_HOST is empty the app logs the message to the console instead of
# sending it, so development needs no mail server.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FirstBench Exams <no-reply@firstbench.tech>"
